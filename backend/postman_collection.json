{
  "info": {
    "name": "E-Learning Platform API",
    "description": "Somalia E-Learning Platform — Complete API Collection\n\nHow to use:\n1. Import this file into Postman\n2. Set the `base_url` variable to http://localhost:5000/api\n3. Login with any account — the token is auto-saved to `auth_token`\n4. All protected requests use {{auth_token}} automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000/api" },
    { "key": "auth_token", "value": "" },
    { "key": "course_id", "value": "" },
    { "key": "student_id", "value": "" },
    { "key": "teacher_id", "value": "" },
    { "key": "section_id", "value": "" },
    { "key": "lesson_id", "value": "" },
    { "key": "quiz_id", "value": "" },
    { "key": "question_id", "value": "" },
    { "key": "assignment_id", "value": "" },
    { "key": "submission_id", "value": "" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "if (r.data && r.data.token) {",
            "  pm.collectionVariables.set('auth_token', r.data.token);",
            "  console.log('Token saved:', r.data.token.slice(0,30) + '...');",
            "}"
          ] } }],
          "request": {
            "method": "POST", "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@elearning.so\",\n  \"password\": \"Admin@1234\"\n}" }
          }
        },
        {
          "name": "Login (Teacher)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "if (r.data && r.data.token) pm.collectionVariables.set('auth_token', r.data.token);"
          ] } }],
          "request": {
            "method": "POST", "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"ahmed@elearning.so\",\n  \"password\": \"Teacher@1234\"\n}" }
          }
        },
        {
          "name": "Login (Student)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "if (r.data && r.data.token) pm.collectionVariables.set('auth_token', r.data.token);"
          ] } }],
          "request": {
            "method": "POST", "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"fadumo@example.so\",\n  \"password\": \"Student@1234\"\n}" }
          }
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET", "url": "{{base_url}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT", "url": "{{base_url}}/auth/change-password",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"current_password\": \"Admin@1234\",\n  \"new_password\": \"NewAdmin@5678\"\n}" }
          }
        },
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "http://localhost:5000/health" }
        }
      ]
    },
    {
      "name": "👑 Admin — Users",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET", "url": { "raw": "{{base_url}}/admin/users?role=student&page=1&limit=20", "query": [
              { "key": "role", "value": "student" }, { "key": "page", "value": "1" }, { "key": "limit", "value": "20" }, { "key": "search", "value": "", "disabled": true }
            ]},
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        },
        {
          "name": "Create Student Account",
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "if (r.data && r.data.id) pm.collectionVariables.set('student_id', r.data.id);"
          ] } }],
          "request": {
            "method": "POST", "url": "{{base_url}}/admin/users",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Hodan Mohamed\",\n  \"email\": \"hodan@example.so\",\n  \"password\": \"Student@1234\",\n  \"role\": \"student\",\n  \"phone\": \"+252 61 9876543\"\n}" }
          }
        },
        {
          "name": "Create Teacher Account",
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "if (r.data && r.data.id) pm.collectionVariables.set('teacher_id', r.data.id);"
          ] } }],
          "request": {
            "method": "POST", "url": "{{base_url}}/admin/users",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"full_name\": \"Faadumo Xasan\",\n  \"email\": \"faadumo.teacher@elearning.so\",\n  \"password\": \"Teacher@1234\",\n  \"role\": \"teacher\"\n}" }
          }
        },
        {
          "name": "Get User Detail",
          "request": {
            "method": "GET", "url": "{{base_url}}/admin/users/{{student_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        },
        {
          "name": "Deactivate User",
          "request": {
            "method": "DELETE", "url": "{{base_url}}/admin/users/{{student_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        },
        {
          "name": "Reset User Password",
          "request": {
            "method": "PUT", "url": "{{base_url}}/admin/users/{{student_id}}/reset-password",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"new_password\": \"NewPass@1234\"\n}" }
          }
        }
      ]
    },
    {
      "name": "🔑 Admin — Course Access (Payment Gate)",
      "item": [
        {
          "name": "Get Student Course Access",
          "request": {
            "method": "GET", "url": "{{base_url}}/admin/students/{{student_id}}/access",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        },
        {
          "name": "✅ Grant Course Access (after payment)",
          "request": {
            "method": "POST", "url": "{{base_url}}/admin/students/{{student_id}}/access",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"course_id\": \"{{course_id}}\",\n  \"notes\": \"Paid $50 via EVC Plus on 2024-01-15\"\n}" }
          }
        },
        {
          "name": "❌ Revoke Course Access",
          "request": {
            "method": "DELETE", "url": "{{base_url}}/admin/students/{{student_id}}/access/{{course_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        }
      ]
    },
    {
      "name": "💰 Admin — Payment Logs",
      "item": [
        {
          "name": "Get All Payments",
          "request": {
            "method": "GET", "url": "{{base_url}}/admin/payments",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        },
        {
          "name": "Log a Payment",
          "request": {
            "method": "POST", "url": "{{base_url}}/admin/payments",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"student_id\": \"{{student_id}}\",\n  \"course_id\": \"{{course_id}}\",\n  \"amount\": 50.00,\n  \"currency\": \"USD\",\n  \"payment_method\": \"EVC Plus\",\n  \"payment_reference\": \"EVC-20240115-001\",\n  \"payment_date\": \"2024-01-15\",\n  \"notes\": \"Paid via EVC Plus mobile money\"\n}" }
          }
        }
      ]
    },
    {
      "name": "📚 Courses",
      "item": [
        {
          "name": "Browse All Courses (Public)",
          "request": {
            "method": "GET", "url": { "raw": "{{base_url}}/courses?page=1&limit=12", "query": [
              { "key": "page", "value": "1" }, { "key": "limit", "value": "12" },
              { "key": "category", "value": "", "disabled": true },
              { "key": "level", "value": "", "disabled": true },
              { "key": "search", "value": "", "disabled": true }
            ]}
          }
        },
        {
          "name": "Get Course Detail (Public)",
          "request": { "method": "GET", "url": "{{base_url}}/courses/intro-web-development" }
        },
        {
          "name": "My Courses (Teacher)",
          "request": {
            "method": "GET", "url": "{{base_url}}/courses/my",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        },
        {
          "name": "Create Course",
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "if (r.data && r.data.id) pm.collectionVariables.set('course_id', r.data.id);"
          ] } }],
          "request": {
            "method": "POST", "url": "{{base_url}}/courses",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "body": { "mode": "formdata", "formdata": [
              { "key": "title", "value": "Python Programming Basics", "type": "text" },
              { "key": "description", "value": "Learn Python from scratch in Somali language", "type": "text" },
              { "key": "price", "value": "75", "type": "text" },
              { "key": "currency", "value": "USD", "type": "text" },
              { "key": "language", "value": "Somali", "type": "text" },
              { "key": "level", "value": "beginner", "type": "text" },
              { "key": "duration_hours", "value": "20", "type": "text" }
            ]}
          }
        },
        {
          "name": "Publish Course",
          "request": {
            "method": "PUT", "url": "{{base_url}}/courses/{{course_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"is_published\": true\n}" }
          }
        }
      ]
    },
    {
      "name": "📂 Sections & Lessons",
      "item": [
        {
          "name": "Get Sections",
          "request": {
            "method": "GET", "url": "{{base_url}}/courses/{{course_id}}/sections",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        },
        {
          "name": "Create Section",
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "if (r.data && r.data.id) pm.collectionVariables.set('section_id', r.data.id);"
          ] } }],
          "request": {
            "method": "POST", "url": "{{base_url}}/courses/{{course_id}}/sections",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Module 1: Introduction\",\n  \"description\": \"Getting started with the basics\",\n  \"order_index\": 0\n}" }
          }
        },
        {
          "name": "Reorder Sections",
          "request": {
            "method": "PUT", "url": "{{base_url}}/courses/{{course_id}}/sections/reorder",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"order\": [\n    { \"id\": \"{{section_id}}\", \"order_index\": 0 }\n  ]\n}" }
          }
        },
        {
          "name": "Create Lesson (YouTube)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "if (r.data && r.data.id) pm.collectionVariables.set('lesson_id', r.data.id);"
          ] } }],
          "request": {
            "method": "POST", "url": "{{base_url}}/courses/{{course_id}}/sections/{{section_id}}/lessons",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Welcome and Introduction\",\n  \"content_type\": \"youtube\",\n  \"youtube_url\": \"https://youtube.com/watch?v=dQw4w9WgXcQ\",\n  \"duration_minutes\": 8,\n  \"order_index\": 0,\n  \"is_preview\": true\n}" }
          }
        },
        {
          "name": "Create Lesson (Text)",
          "request": {
            "method": "POST", "url": "{{base_url}}/courses/{{course_id}}/sections/{{section_id}}/lessons",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"What is Python?\",\n  \"content_type\": \"text\",\n  \"text_content\": \"Python is a high-level programming language...\",\n  \"duration_minutes\": 5,\n  \"order_index\": 1\n}" }
          }
        },
        {
          "name": "Create Lesson (Upload Video)",
          "request": {
            "method": "POST", "url": "{{base_url}}/courses/{{course_id}}/sections/{{section_id}}/lessons",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "body": { "mode": "formdata", "formdata": [
              { "key": "title", "value": "Variables and Data Types", "type": "text" },
              { "key": "content_type", "value": "video", "type": "text" },
              { "key": "duration_minutes", "value": "15", "type": "text" },
              { "key": "order_index", "value": "2", "type": "text" },
              { "key": "video", "type": "file", "src": "/path/to/your/video.mp4" }
            ]}
          }
        },
        {
          "name": "Reorder Lessons",
          "request": {
            "method": "PUT", "url": "{{base_url}}/courses/{{course_id}}/lessons/reorder",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"order\": [\n    { \"id\": \"{{lesson_id}}\", \"order_index\": 0, \"section_id\": \"{{section_id}}\" }\n  ]\n}" }
          }
        }
      ]
    },
    {
      "name": "🎓 Teacher Dashboard",
      "item": [
        {
          "name": "Teacher Dashboard",
          "request": {
            "method": "GET", "url": "{{base_url}}/teacher/dashboard",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        },
        {
          "name": "Course Students List",
          "request": {
            "method": "GET", "url": "{{base_url}}/teacher/courses/{{course_id}}/students",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        },
        {
          "name": "Course Analytics",
          "request": {
            "method": "GET", "url": "{{base_url}}/teacher/courses/{{course_id}}/analytics",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        },
        {
          "name": "Student Progress Detail",
          "request": {
            "method": "GET", "url": { "raw": "{{base_url}}/teacher/students/{{student_id}}/progress?course_id={{course_id}}", "query": [
              { "key": "course_id", "value": "{{course_id}}" }
            ]},
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        }
      ]
    },
    {
      "name": "📝 Quizzes",
      "item": [
        {
          "name": "Create Quiz",
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "if (r.data && r.data.id) pm.collectionVariables.set('quiz_id', r.data.id);"
          ] } }],
          "request": {
            "method": "POST", "url": "{{base_url}}/quizzes",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"course_id\": \"{{course_id}}\",\n  \"lesson_id\": \"{{lesson_id}}\",\n  \"title\": \"Module 1 Quiz\",\n  \"description\": \"Test your knowledge of Module 1\",\n  \"pass_score\": 70,\n  \"max_attempts\": 3,\n  \"time_limit_minutes\": 15\n}" }
          }
        },
        {
          "name": "Add MCQ Question",
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "if (r.data && r.data.id) pm.collectionVariables.set('question_id', r.data.id);"
          ] } }],
          "request": {
            "method": "POST", "url": "{{base_url}}/quizzes/{{quiz_id}}/questions",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"question\": \"What does HTML stand for?\",\n  \"question_type\": \"mcq\",\n  \"options\": [\n    \"HyperText Markup Language\",\n    \"High Tech Modern Language\",\n    \"HyperText Modern Links\",\n    \"Home Tool Markup Language\"\n  ],\n  \"correct_answer\": \"HyperText Markup Language\",\n  \"points\": 2\n}" }
          }
        },
        {
          "name": "Add True/False Question",
          "request": {
            "method": "POST", "url": "{{base_url}}/quizzes/{{quiz_id}}/questions",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"question\": \"Python is a compiled language.\",\n  \"question_type\": \"true_false\",\n  \"options\": [\"True\", \"False\"],\n  \"correct_answer\": \"False\",\n  \"points\": 1\n}" }
          }
        },
        {
          "name": "Get Quiz (with questions)",
          "request": {
            "method": "GET", "url": "{{base_url}}/quizzes/{{quiz_id}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        },
        {
          "name": "Get Questions Only",
          "request": {
            "method": "GET", "url": "{{base_url}}/quizzes/{{quiz_id}}/questions",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        },
        {
          "name": "Student: Submit Quiz",
          "request": {
            "method": "POST", "url": "{{base_url}}/quizzes/{{quiz_id}}/submit",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"answers\": {\n    \"{{question_id}}\": \"HyperText Markup Language\"\n  }\n}" }
          }
        },
        {
          "name": "Student: My Quiz Results",
          "request": {
            "method": "GET", "url": "{{base_url}}/quizzes/{{quiz_id}}/results",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        },
        {
          "name": "Teacher: All Student Attempts",
          "request": {
            "method": "GET", "url": "{{base_url}}/quizzes/{{quiz_id}}/all-attempts",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        },
        {
          "name": "Reorder Questions",
          "request": {
            "method": "PUT", "url": "{{base_url}}/quizzes/{{quiz_id}}/questions/reorder",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"order\": [\n    { \"id\": \"{{question_id}}\", \"order_index\": 0 }\n  ]\n}" }
          }
        }
      ]
    },
    {
      "name": "📋 Assignments",
      "item": [
        {
          "name": "Get Assignments for Course",
          "request": {
            "method": "GET", "url": { "raw": "{{base_url}}/assignments?course_id={{course_id}}", "query": [
              { "key": "course_id", "value": "{{course_id}}" }
            ]},
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }]
          }
        },
        {
          "name": "Create Assignment",
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "if (r.data && r.data.id) pm.collectionVariables.set('assignment_id', r.data.id);"
          ] } }],
          "request": {
            "method": "POST", "url": "{{base_url}}/assignments",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"course_id\": \"{{course_id}}\",\n  \"lesson_id\": \"{{lesson_id}}\",\n  \"title\": \"Build a simple HTML page\",\n  \"description\": \"Create a personal profile page using HTML and CSS. Include your name, photo, and a short bio.\",\n  \"due_date\": \"2025-02-01T23:59:00Z\",\n  \"max_grade\": 100\n}" }
          }
        },
        {
          "name": "Student: Submit Assignment (Text)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const r = pm.response.json();",
            "if (r.data && r.data.id) pm.collectionVariables.set('submission_id', r.data.id);"
          ] } }],
          "request": {
            "method": "POST", "url": "{{base_url}}/assignments/{{assignment_id}}/submit",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"submission_text\": \"I built my HTML page. Here is the code: <html><body><h1>Hodan Mohamed</h1></body></html>\"\n}" }
          }
        },
        {
          "name": "Student: Submit Assignment (File Upload)",
          "request": {
            "method": "POST", "url": "{{base_url}}/assignments/{{assignment_id}}/submit",
            "header": [{ "key": "Authorization", "value": "Bearer {{auth_token}}" }],
            "body": { "mode": "formdata", "formdata": [
              { "key": "submission_text", "value": "My assignment file is attached.", "type": "text" },
              { "key": "file", "type": "file", "src": "/path/to/assignment.pdf" }
            ]}
          }
        },
        {
          "name": "Student: View My Submission",
